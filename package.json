{
  "name": "further",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "map": "node scripts/dependency-map.mjs",
    "check": "npm run typecheck && npm run lint && npm test && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-rds-data": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "google-auth-library": "^11.3.2",
    "jose": "^6.2.15",
    "mermaid": "^12.2.0",
    "next": "^15.5.28",
    "openai": "^7.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
