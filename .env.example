# Copy to .env (ignored by git) and fill in only what you have.
# With no keys at all, Further runs in demo mode: no network calls, no charges.
#
# Providers are tried in this order. Any provider without its settings is skipped,
# and demo is always last, so the app never breaks. Only use Meta-family models.
FURTHER_PROVIDERS=meta,fireworks,baseten,demo
FURTHER_PROVIDER_TIMEOUT_SECONDS=10
# Optional: FURTHER_AI_MODE=demo forces demo only; FURTHER_AI_MODE=meta forces Meta only
# and shows errors instead of falling back. Leave unset to use FURTHER_PROVIDERS.
# FURTHER_AI_MODE=

# 1. Meta Model API (Muse). Docs: https://dev.meta.ai/docs/quickstart
#    URL and model below are the starter's documented values (checked Oct 27, 2026).
META_API_KEY=
META_API_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# 2. Fireworks, OpenAI-compatible. TODO: copy the base URL (without /chat/completions)
#    and a Meta Llama model ID from https://docs.fireworks.ai/ . Left blank on purpose.
FIREWORKS_API_KEY=
FIREWORKS_URL=
FIREWORKS_MODEL=

# 3. Baseten, OpenAI-compatible. TODO: copy the base URL (without /chat/completions)
#    and a Meta Llama model ID from https://docs.baseten.co/ . Left blank on purpose.
BASETEN_API_KEY=
BASETEN_URL=
BASETEN_MODEL=
