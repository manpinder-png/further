# Default mode keeps data and media local. Use scripts/dev.py --aws for the shared AWS layer.
# Missing inference keys fail visibly; they never silently activate sample mode.
# Prefer macOS Keychain via scripts/dev.py. Never commit .env.local.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Set muse-wonder-1.0 only for deliberately deeper map reasoning.
FURTHER_MAP_MODEL=muse-spark-1.3
BASETEN_API_KEY=
# Use baseten only when BASETEN_API_KEY is configured; Meta is sufficient to start.
FURTHER_METADATA_PROVIDER=meta
# Only this exact Baseten hackathon model is accepted by the adapter:
# meta-models/muse-spark-open-1026
FURTHER_MODEL_MODE=live
FURTHER_DATA_DIR=.local/data/pglite
FURTHER_LOCAL_DIR=.local
FURTHER_EMBEDDING_URL=http://127.0.0.1:8767
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BUILDER_VIEW=false
# Real accounts are the default. Synthetic persona switching is opt-in for tests only.
FURTHER_ENABLE_LOCAL_PROFILES=0
# Google Cloud OAuth client type: Web application. Scope is sign-in only (no Gmail access).
# Keep actual credentials in ignored .env.local with mode 600.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# AWS configuration is generated from stack outputs into ignored .local/aws.json.
# python3 scripts/configure-aws.py --profile YOUR_PROFILE --region us-east-1 --account SHARED_AWS_ACCOUNT_ID
# python3 scripts/dev.py --aws
# Browser code never receives developer AWS credentials or provider API keys.
