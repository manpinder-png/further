# All product data, media and embedding computation stay on this machine.
# Missing inference keys fail visibly; they never silently activate sample mode.
# Prefer macOS Keychain via scripts/dev.py. Never commit .env.local.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Set muse-wonder-1.0 only for deliberately deeper map reasoning.
FURTHER_MAP_MODEL=muse-spark-1.3
BASETEN_API_KEY=
FURTHER_METADATA_PROVIDER=baseten
# Only this exact Baseten hackathon model is accepted by the adapter:
# meta-models/muse-spark-open-1026
FURTHER_MODEL_MODE=live
FURTHER_DATA_DIR=.local/data/pglite
FURTHER_LOCAL_DIR=.local
FURTHER_EMBEDDING_URL=http://127.0.0.1:8767
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BUILDER_VIEW=false
