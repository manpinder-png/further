# Copy to .env.local (ignored by git). With no keys, Further runs in DEMO mode:
# every AI/realtime surface uses labeled demo data and makes no network calls.

# --- Meta Model API (Muse). OpenAI-compatible. Owner: Connor
META_API_KEY=
META_API_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3              # real user data
META_DEV_MODEL=muse-spark-1.3-contributor   # dev + evals only (Meta trains on it)
META_TRANSCRIBE_MODEL=muse-voice-transcribe
META_IMAGE_MODEL=muse-image

# --- Supabase (Postgres, pgvector, Auth, Realtime). Owner: Connor / Amit
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # server only, never NEXT_PUBLIC_

# --- Llama Guard on partner credits (Fireworks or Baseten). Owner: Amit
LLAMA_GUARD_URL=
LLAMA_GUARD_API_KEY=
LLAMA_GUARD_MODEL=

# --- Ops. Owner: Connor
SENTRY_DSN=
RATE_LIMIT_EXPANSIONS_PER_HOUR=30
